{
  "include": [
    "cypress/**/*.ts",
    "cypress/support/step_definitions/HomePage_steps.ts",
    "cypress/support/step_definitions/ProductsPage_steps.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["cypress", "node", "cypress-wait-until"],
    "paths": {
      "@cypress-e2e/*": ["./cypress/*"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "esModuleInterop": true,
    "target": "ES5"
  }
}
